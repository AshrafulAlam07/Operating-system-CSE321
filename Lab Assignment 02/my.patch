diff --git a/kernel/proc.c b/kernel/proc.c
index 22a5401..39d9342 100644
--- a/kernel/proc.c
+++ b/kernel/proc.c
@@ -102,6 +102,30 @@ allocpid()
   return pid;
 }
 
+int do_rand(unsigned long *ctx)
+{
+  long hi, lo, x;
+
+  x = (*ctx % 0x7ffffffe) + 1;
+  hi = x / 127773;
+  lo = x % 127773;
+  x = 16807 * lo - 2836 * hi;
+  if (x < 0)
+    x += 0x7fffffff;
+
+  x--;
+  *ctx = x;
+  return (x);
+}
+
+unsigned long rand_next = 1;
+
+int
+rand(void)
+{
+  return do_rand(&rand_next);
+}
+
 // Look in the process table for an UNUSED proc.
 // If found, initialize state required to run in the kernel,
 // and return with p->lock held.
@@ -124,6 +148,8 @@ allocproc(void)
 found:
   p->pid = allocpid();
   p->state = USED;
+  p->tickets = 1;
+  p->rounds = 0;
 
   // Allocate a trapframe page.
   if((p->trapframe = (struct trapframe *)kalloc()) == 0){
@@ -223,7 +249,9 @@ userinit(void)
 
   p = allocproc();
   initproc = p;
-  
+  p->tickets = 10;
+  p->rounds = 0;
+
   p->cwd = namei("/");
 
   p->state = RUNNABLE;
@@ -281,6 +309,8 @@ kfork(void)
 
   // Cause fork to return 0 in the child.
   np->trapframe->a0 = 0;
+  np->tickets = p->tickets;
+  np->rounds = 0;
 
   // increment reference counts on open file descriptors.
   for(i = 0; i < NOFILE; i++)
@@ -438,23 +468,42 @@ scheduler(void)
     intr_off();
 
     int found = 0;
+    int total_tickets = 0;
     for(p = proc; p < &proc[NPROC]; p++) {
       acquire(&p->lock);
-      if(p->state == RUNNABLE) {
-        // Switch to chosen process.  It is the process's job
-        // to release its lock and then reacquire it
-        // before jumping back to us.
-        p->state = RUNNING;
-        c->proc = p;
-        swtch(&c->context, &p->context);
-
-        // Process is done running for now.
-        // It should have changed its p->state before coming back.
-        c->proc = 0;
-        found = 1;
-      }
+      if(p->state == RUNNABLE)
+        total_tickets += p->tickets;
       release(&p->lock);
     }
+
+    if(total_tickets > 0) {
+      int winning = rand() % total_tickets;
+      int current = 0;
+      for(p = proc; p < &proc[NPROC]; p++) {
+        acquire(&p->lock);
+        if(p->state == RUNNABLE) {
+          current += p->tickets;
+          if(current > winning) {
+            // Switch to chosen process.  It is the process's job
+            // to release its lock and then reacquire it
+            // before jumping back to us.
+            p->state = RUNNING;
+            c->proc = p;
+            p->rounds += 1;
+            swtch(&c->context, &p->context);
+
+            // Process is done running for now.
+            // It should have changed its p->state before coming back.
+            c->proc = 0;
+            found = 1;
+            release(&p->lock);
+            break;
+          }
+        }
+        release(&p->lock);
+      }
+    }
+
     if(found == 0) {
       // nothing to run; stop running on this core until an interrupt.
       asm volatile("wfi");
@@ -684,7 +733,6 @@ procdump(void)
       state = states[p->state];
     else
       state = "???";
-    printf("%d %s %s", p->pid, state, p->name);
-    printf("\n");
+    printf("%d %s %s %d %d\n", p->pid, state, p->name, p->tickets, p->rounds);
   }
 }
