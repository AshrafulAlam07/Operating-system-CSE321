+uint64
+sys_settickets(void)
+{
+  int n;
+  struct proc *p = myproc();
+
+  argint(0, &n);
+  if(n <= 0)
+    return -1;
+
+  acquire(&p->lock);
+  p->tickets = n;
+  release(&p->lock);
+  return 0;
+}
+
